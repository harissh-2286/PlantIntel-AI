{
  "framework": "vite",
  "buildCommand": "sh -c \"if [ -d frontend ]; then cd frontend; fi; npm install; npm run build\"",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
