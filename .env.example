# PlantIntel AI Environment Variables Configuration
# Copy this file to .env and fill in the environment specific values.

# Model & Execution Mode ('pretrained', 'attention', 'baseline')
MODEL_MODE=attention
MODEL_PATH=models/checkpoints/plantintel_v2_best.pt

# Database Connection URL (SQLite default or PostgreSQL)
DATABASE_URL=sqlite:///./plantintel.db

# Reproducibility Seed
SEED=42

# Execution Device ('cpu', 'cuda', 'mps', or 'auto')
DEVICE=auto

# Allowed CORS Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo Mode Toggle ('true' or 'false')
DEMO_MODE=false
